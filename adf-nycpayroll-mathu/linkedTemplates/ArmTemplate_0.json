		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nycpayroll-mathu"
		},
		"ls_adls_payroll_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_payroll'"
		},
		"ls_sql_payroll_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_payroll'"
		},
		"ls_synapse_analytics_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_synapse_analytics'"
		},
		"ls_adls_payroll_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsnycpayrollmathu.dfs.core.windows.net/"
		},
		"ls_sql_payroll_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "nycdbserver.database.windows.net"
		},
		"ls_sql_payroll_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_nycpayroll"
		},
		"ls_sql_payroll_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "udacityadmin"
		},
		"ls_synapse_analytics_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "syn-nycpayroll-mathu-ondemand.sql.azuresynapse.net"
		},
		"ls_synapse_analytics_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "udacity"
		},
		"ls_synapse_analytics_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "udacityadmin"
		}
	},
